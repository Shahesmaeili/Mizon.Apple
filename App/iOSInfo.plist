<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLName</key>
            <string>com.shahesmaeili.Mizon.Apple.deeplink</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>mizon</string>
            </array>
        </dict>
    </array>
    <key>NSBonjourServices</key>
    <array>
        <string>_mizon-peer._tcp</string>
    </array>
    <key>MizonDevelopmentTLSOrigin</key>
    <string>$(MIZON_DEVELOPMENT_TLS_ORIGIN)</string>
    <key>MizonDevelopmentTLSLeafSHA256</key>
    <string>$(MIZON_DEVELOPMENT_TLS_LEAF_SHA256)</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Mizon uses your local network to connect to your server and discover devices while you are signed in. Nearby Mizon users can see your device details and public profile. You can turn discovery off in Mizon.</string>
    <key>NSMotionUsageDescription</key>
    <string>Mizon uses your phone’s motion sensor to move the three Music Home images as you tilt your phone.</string>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>MizonLaunchBackground</string>
    </dict>
</dict>
</plist>
